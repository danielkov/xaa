# Credentials for `xaa-client --playground` (https://xaa.dev).
#
# Copy to `.env` (git-ignored), fill in, then:
#
#   source examples/client/.env && cargo run -p xaa-client -- --playground
#
# Register the app at https://xaa.dev/developer/register with the redirect URI
# http://127.0.0.1:8765/callback, connected to the Todo resource with the
# `todos.read` scope. Registration shows all four values.

# Main client: used at the IdP (https://idp.xaa.dev).
export XAA_IDP_CLIENT_ID=''
export XAA_IDP_CLIENT_SECRET=''

# Resource client: used at the Resource AS (https://auth.resource.xaa.dev).
# Its ID has the form {client_id}-at-{resource_id}.
export XAA_RESOURCE_AS_CLIENT_ID=''
export XAA_RESOURCE_AS_CLIENT_SECRET=''

# Optional. A refresh token printed by `--playground --print-refresh-token`.
# When set, later runs skip the browser login and use it as the subject token.
export XAA_REFRESH_TOKEN=''

# Optional overrides (defaults shown).
# export XAA_SCOPE='todos.read'
# export XAA_REDIRECT_URI='http://127.0.0.1:8765/callback'

# `--playground --saml` uses the credentials of a SAML app instead (the SAML
# tab of the same page): keep them in a second file, `.env.saml`, with the
# same four variables plus the two below, which must match the registration.
# export XAA_SAML_SP_ENTITY_ID='http://localhost:8765/saml/metadata'
# export XAA_SAML_ACS_URL='http://localhost:8765/saml/acs'
